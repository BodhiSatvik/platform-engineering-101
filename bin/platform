#!/usr/bin/env python3
"""platform: the one tool an app team needs. It speaks in apps, not in Kubernetes.

  platform deploy <app.yaml>   create or update an app from a short app file
  platform status              list your apps and how they are doing
  platform open <name>         open the app in your browser, on port 8081
  platform logs <name>         show the app's recent logs
  platform restart <name>      restart the app's copies, one at a time
  platform delete <name>       retire the app and everything the platform made for it
"""

import json
import os
import re
import subprocess
import sys
import time

import yaml

API = "applications.platform.example.com"
FIELDS = ("name", "image", "plan", "replicas", "database", "port")
PORT = 8081  # Lab 1 used 8080, so both apps can be open side by side
COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ


def paint(code, text):
    return f"\033[{code}m{text}\033[0m" if COLOR else text


def ok(text, after=""):
    print(paint("32", "  ✓ ") + text + (paint("2", f"  {after}") if after else ""))


def fail(problem, fix=""):
    print(paint("31", "  ✗ ") + problem)
    if fix:
        print(paint("2", "    fix: ") + fix)
    sys.exit(1)


def kubectl(*args, stdin=None):
    return subprocess.run(["kubectl", *args], input=stdin, capture_output=True, text=True)


def deploy(path):
    try:
        with open(path) as f:
            app = yaml.safe_load(f) or {}
    except (OSError, yaml.YAMLError) as error:
        fail(f"cannot read {path}: {error}")
    if not isinstance(app, dict):
        fail(f"{path} must hold fields like  name: coffee", f"use only: {', '.join(FIELDS)}")
    unknown = sorted(set(app) - set(FIELDS))
    if unknown:
        fail(f"{', '.join(unknown)}: not a field the platform knows.", f"use only: {', '.join(FIELDS)}")
    name = str(app.pop("name", "")).strip()
    if not name:
        fail("name: missing.", "add a line like  name: coffee")

    print(paint("1", f"▸ deploying {name}"))
    body = {"apiVersion": "platform.example.com/v1", "kind": "Application", "metadata": {"name": name}, "spec": app}
    result = kubectl("apply", "--server-side", "--force-conflicts", "--field-manager=platform-cli", "-f", "-",
                     stdin=json.dumps(body))  # your app file always wins
    if result.returncode:
        fail(*explain(result.stderr))
    ok("request accepted: the platform takes it from here")
    follow(name)


def follow(name, timeout=300):
    """Print each step the platform reports, until the app is ready or fails."""
    start, shown, warned = time.monotonic(), 0, False
    while (elapsed := time.monotonic() - start) < timeout:
        app = json.loads(kubectl("get", f"{API}/{name}", "-o", "json").stdout or "{}")
        status = app.get("status", {})
        if app and status.get("observedGeneration") == app["metadata"]["generation"]:
            steps = status.get("steps", [])
            shown = min(shown, len(steps))  # a retry starts the list again
            for step in steps[shown:]:
                ok(step, f"{elapsed:.0f}s")
            shown = len(steps)
            if status.get("phase") == "Ready":
                print(paint("1;32", f"➜ ready in {elapsed:.0f}s.") + f" open it: platform open {name}")
                return
            if status.get("phase") == "Failed":
                problem, _, fix = status.get("message", "").partition(" fix: ")
                fail(problem, fix)
        elif elapsed > 10 and not warned:
            print(paint("2", "  … waiting for the platform. Is the operator running in your second terminal?"))
            warned = True
        time.sleep(1)
    fail(f"still working after {timeout // 60} minutes.", "check: platform status")


def explain(error):
    """Turn the API server's answer into two parts: what is wrong, and how to fix it."""
    error = error.strip()
    if "ensure CRDs are installed" in error or "no matches for kind" in error:
        return "this cluster does not have the platform's API yet.", "run ./setup/setup.sh"
    if " is invalid: " not in error:
        return error, ""
    details = error.split(" is invalid: ", 1)[1].strip().strip("[]")
    if details.startswith("* "):  # several problems, one per line
        items = [line.removeprefix("* ") for line in details.splitlines()]
    else:
        items = re.split(r", (?=(?:spec|metadata)\.)", details)
    problems, fixes = [], []
    for item in items:
        field, _, why = item.partition(": ")
        if field == "<nil>":  # "some rules were not checked": noise until the first problem is fixed
            continue
        field = field.removeprefix("spec.").removeprefix("metadata.")
        if field == "name":
            problems.append("name: use lowercase letters, digits and dashes.")
        elif why.startswith("Unsupported value: "):
            value, _, choices = why.removeprefix("Unsupported value: ").partition(": supported values: ")
            problems.append(f"{field}: {value} is not one of the choices.")
            fixes.append(f"use one of {choices}")
        elif why.startswith("Required value"):
            problems.append(f"{field}: missing.")
            fixes.append(f"add a line like  {field}: ...")
        else:
            message = why.split(": ", 2)[-1]
            problems.append(message if message.startswith(field) else f"{field}: {message}")
    return " ".join(problems), "; ".join(fixes)


def status():
    result = kubectl("get", API)
    print(result.stdout.rstrip() or "No apps yet. Deploy one: platform deploy lab2/app.yaml")


def open_app(name):
    subprocess.Popen([sys.executable, __file__, "forward", name], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(paint("1", f"➜ http://localhost:{PORT}") + f"   (in a Codespace: the Ports tab, port {PORT})")
    print(paint("2", "  It stays open in the background and reconnects by itself if a copy restarts."))


def forward(name):
    """Keep a port-forward to the app open. `platform open` runs this in the background."""
    down_since = None
    try:
        while True:  # port-forward stops when its pod goes away: start it again
            started = time.monotonic()
            result = subprocess.run(["kubectl", "-n", name, "port-forward", f"svc/{name}", f"{PORT}:80"],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
            if time.monotonic() - started > 5:
                down_since = None  # it worked for a while, so just reconnect
            elif down_since is None:
                down_since = started
            elif time.monotonic() - down_since > 60:
                fail(f"cannot reach {name}: {result.stderr.strip()}", "check: platform status")
            time.sleep(2)
    except KeyboardInterrupt:
        print()


def logs(name):
    subprocess.run(["kubectl", "-n", name, "logs", "-l", f"app={name}", "--prefix", "--tail", "20"])


def restart(name):
    print(paint("1", f"▸ restarting {name}: one copy at a time, so the app stays up"))
    for args in (["rollout", "restart", f"deploy/{name}"], ["rollout", "status", f"deploy/{name}", "--timeout=120s"]):
        result = kubectl("-n", name, *args)
        if result.returncode:
            fail(result.stderr.strip())
    ok("all copies restarted")


def delete(name):
    result = kubectl("delete", f"{API}/{name}", "--wait=false")
    if result.returncode:
        fail(result.stderr.strip())
    ok(f"{name} retired. Kubernetes now deletes its namespace and everything in it.")


COMMANDS = {"deploy": deploy, "status": status, "open": open_app, "logs": logs, "restart": restart, "delete": delete,
            "forward": forward}

if __name__ == "__main__":
    command, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("", [])
    expected = 0 if command == "status" else 1
    if command not in COMMANDS or len(args) != expected:
        sys.exit(__doc__)
    COMMANDS[command](*args)
